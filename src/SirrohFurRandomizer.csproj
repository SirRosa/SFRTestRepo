<Project Sdk="Microsoft.NET.Sdk">
  <!-- Editable build wrapper; recovered/source is the untouched ILSpy export. -->
  <PropertyGroup>
    <AssemblyName>SirrohFurRandomizer</AssemblyName>
    <RootNamespace>BalrondFurRandomizer</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == ''">$(MSBuildThisFileDirectory)../_references/Managed</ValheimManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(MSBuildThisFileDirectory)../_references/BepInEx/core</BepInExCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../recovered/source/**/*.cs" />
    <EmbeddedResource Include="../recovered/assets/raw/BalrondFurRandomizer.furrandomizer"
                      LogicalName="BalrondFurRandomizer.furrandomizer" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ValheimManagedDir)/UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManagedDir)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManagedDir)/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ValheimManagedDir)/assembly_valheim.dll')"
           Text="Missing Valheim references: set /p:ValheimManagedDir=... to valheim_Data/Managed." />
    <Error Condition="!Exists('$(BepInExCoreDir)/BepInEx.dll')"
           Text="Missing BepInEx references: set /p:BepInExCoreDir=... to BepInEx/core." />
  </Target>
</Project>
